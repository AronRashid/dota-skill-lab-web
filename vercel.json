{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/user-state",
      "destination": "/api/user-state.js"
    },
    {
      "source": "/api/steam/bundle",
      "destination": "/api/bundle20.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?__dsl_path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/bundle20.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/user-state.js": {
      "maxDuration": 30,
      "memory": 512
    }
  }
}
